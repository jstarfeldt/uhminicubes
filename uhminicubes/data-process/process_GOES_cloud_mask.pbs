#!/bin/bash
#PBS -N process_GOES_cloud_mask
#PBS -A umcp0048
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=16:mem=8gb
#PBS -l job_priority=economy
#PBS -q develop
#PBS -j oe

set -euo pipefail

echo "=============================================="
echo "Job started at: $(date)"
echo "Running on host: $(hostname)"
echo "Working directory: $PBS_O_WORKDIR"
echo "=============================================="

# Unbuffered Python so progress prints appear promptly in the log
export PYTHONUNBUFFERED=1

source /glade/u/apps/opt/conda/bin/activate
conda activate heat

echo ""
echo "Python environment:"
which python
python --version
echo ""

echo "First argument: $CITY Second argument: $YEAR"

cd /glade/u/home/jstarfeldt/uhminicubes/uhminicubes/data-process
python -u
python process_GOES_cloud_mask.py --city=$CITY --year=$YEAR --cpus=16

echo ""
echo "=============================================="
echo "Job finished at: $(date)"
echo "=============================================="

exit
